{
  "name": "microservice-qr-code",
  "version": "0.0.1",
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read src/index.ts",
    "bundle": "deno bundle src/index.ts dist/index.js"
  },
  "imports": {
    "qr-image": "npm:qr-image@^3.2.0"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80,
    "useTabs": false
  }
}
