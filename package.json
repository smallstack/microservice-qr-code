{
  "name": "microservice-qr-code",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "QR code microservice deployed as a Bunny CDN Edge Script.",
  "scripts": {
    "dev": "deno run --allow-net --allow-env --allow-read src/index.ts",
    "deploy": "bunny deploy",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "@types/qr-image": "^3.2.9",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "qr-image": "^3.2.0"
  }
}
